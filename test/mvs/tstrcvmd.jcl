//TSTRCVMS JOB (OFTP),'RCVM SETUP',CLASS=A,MSGCLASS=H
//* ------------------------------------------------------------------
//* Set-up for TSTRCVM (test/mvs/tstrcvm.jcl): the two spools, the two
//* data sets the test sends, the member of receive rules B reads. Run
//* once. Change the volume of the spools (VOLUMES) to one with VSAM
//* space of your catalog; the cluster is UNIQUE.
//* ------------------------------------------------------------------
//OLD      EXEC PGM=IEFBR14
//D1       DD  DISP=(MOD,DELETE),DSN=IBMUSER.TSTRCVM.D1,
//             UNIT=SYSDA,SPACE=(TRK,1)
//D2       DD  DISP=(MOD,DELETE),DSN=IBMUSER.TSTRCVM.D2,
//             UNIT=SYSDA,SPACE=(TRK,1)
//RULES    DD  DISP=(MOD,DELETE),DSN=IBMUSER.TSTRCVM.RULES,
//             UNIT=SYSDA,SPACE=(TRK,1)
//SPOOLS   EXEC PGM=IDCAMS
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  DELETE IBMUSER.OFTPA.SPOOL CLUSTER PURGE
  DELETE IBMUSER.OFTPB.SPOOL CLUSTER PURGE
  SET MAXCC=0
  DEFINE CLUSTER (NAME(IBMUSER.OFTPA.SPOOL) -
                  INDEXED KEYS(8 0) RECORDSIZE(512 512) -
                  TRACKS(15 15) SHAREOPTIONS(1 3) UNIQUE -
                  VOLUMES(WORK01)) -
         DATA   (NAME(IBMUSER.OFTPA.SPOOL.DATA)) -
         INDEX  (NAME(IBMUSER.OFTPA.SPOOL.INDEX))
  DEFINE CLUSTER (NAME(IBMUSER.OFTPB.SPOOL) -
                  INDEXED KEYS(8 0) RECORDSIZE(512 512) -
                  TRACKS(15 15) SHAREOPTIONS(1 3) UNIQUE -
                  VOLUMES(WORK01)) -
         DATA   (NAME(IBMUSER.OFTPB.SPOOL.DATA)) -
         INDEX  (NAME(IBMUSER.OFTPB.SPOOL.INDEX))
/*
//MAKE1    EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
D1 THE FIRST FILE
LINE 2
LINE 3
/*
//SYSUT2   DD  DSN=IBMUSER.TSTRCVM.D1,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,1),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//MAKE2    EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
D2 THE SECOND FILE
LINE 2
/*
//SYSUT2   DD  DSN=IBMUSER.TSTRCVM.D2,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,1),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//* what a REPLACE=Y rule must not rename: a PDS (with a copy of it, to
//* compare with afterwards) and a VSAM cluster
//DELPDS   EXEC PGM=IEFBR14
//D1       DD  DISP=(MOD,DELETE),DSN=IBMUSER.RCVTEST.PDS.ONE,
//             UNIT=SYSDA,SPACE=(TRK,1)
//D2       DD  DISP=(MOD,DELETE),DSN=IBMUSER.RCVTEST.PDS.ONE.COPY,
//             UNIT=SYSDA,SPACE=(TRK,1)
//MAKEPDS  EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
A MEMBER OF A PDS
/*
//SYSUT2   DD  DSN=IBMUSER.RCVTEST.PDS.ONE(MEM),DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(1,1,1)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120,DSORG=PO)
//COPYPDS  EXEC PGM=IEBCOPY
//SYSPRINT DD  SYSOUT=*
//IN       DD  DISP=SHR,DSN=IBMUSER.RCVTEST.PDS.ONE
//OUT      DD  DSN=IBMUSER.RCVTEST.PDS.ONE.COPY,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(1,1,1)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120,DSORG=PO)
//SYSIN    DD  *
         COPY INDD=IN,OUTDD=OUT
/*
//VSAM     EXEC PGM=IDCAMS
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  DELETE IBMUSER.RCVTEST.PDS.TWO CLUSTER PURGE
  SET MAXCC=0
  DEFINE CLUSTER (NAME(IBMUSER.RCVTEST.PDS.TWO) -
                  INDEXED KEYS(8 0) RECORDSIZE(80 80) -
                  TRACKS(1 1) SHAREOPTIONS(1 3) UNIQUE -
                  VOLUMES(WORK01)) -
         DATA   (NAME(IBMUSER.RCVTEST.PDS.TWO.DATA)) -
         INDEX  (NAME(IBMUSER.RCVTEST.PDS.TWO.INDEX))
/*
//* the jobs of the JOB= rules (#45): RCVJOB copies the file OFTPD made
//* to a data set named after ?ID and another named after ?VFILE; RCVLONG
//* has a line that grows past column 71 with ?PFILE and must not run
//DELJCL   EXEC PGM=IEFBR14
//D1       DD  DISP=(MOD,DELETE),DSN=IBMUSER.TSTRCVM.JCL,
//             UNIT=SYSDA,SPACE=(TRK,1)
//MAKEJ1   EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DATA,DLM='@@'
//RCVJOB   JOB (OFTP),'RCV JOB',CLASS=A,MSGCLASS=H
//* ?KEY ?VFILE ?ID ?PFILE
//COPY1    EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DISP=SHR,DSN=?PFILE
//SYSUT2   DD  DSN=IBMUSER.RCVTEST.JOBOUT.?ID,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,1),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//COPY2    EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DISP=SHR,DSN=?PFILE
//SYSUT2   DD  DSN=IBMUSER.RCVTEST.JOBV.?VFILE,
//             DISP=(NEW,CATLG),UNIT=SYSDA,SPACE=(TRK,1),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
@@
//SYSUT2   DD  DSN=IBMUSER.TSTRCVM.JCL(RCVJOB),DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(1,1,6)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120,DSORG=PO)
//MAKEJ2   EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DATA,DLM='@@'
//RCVLONG  JOB (OFTP),'RCV JOB LONG',CLASS=A,MSGCLASS=H
//COPY     EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DISP=SHR,DSN=?PFILE,DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSUT2   DD  DSN=IBMUSER.RCVTEST.JOBOUT.LONG,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,1),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
@@
//SYSUT2   DD  DSN=IBMUSER.TSTRCVM.JCL(RCVLONG),DISP=OLD
//* the edge of the card (#45): the text of a // statement ends in column
//* 71. RCVQ71 has a DD statement of exactly 71 columns after ?ID went in,
//* its comma in column 71 (and a sequence number in 73-80): it runs.
//* RCVQ72 has one of 72 columns: no job. RCVSYM has the symbols that
//* stay (?IDX ?PFILE1 ?KEYS ?VFILEX) and the ones that go (?ID.X ?ID-?KEY)
//* as data of its own job, which copies them to a data set. A load
//* library member (RECFM=U) is what a JOB= must refuse.
//MAKEJ3   EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DATA,DLM='@@'
//RCVQ71   JOB (OFTP),'RCV Q71',CLASS=A,MSGCLASS=H
//S        EXEC PGM=IEFBR14
//D                                DD  DSN=IBMUSER.RCVTEST.JOBQ71.?ID,  Q71OK010
//             DISP=(NEW,CATLG),UNIT=SYSDA,SPACE=(TRK,1)
@@
//SYSUT2   DD  DSN=IBMUSER.TSTRCVM.JCL(RCVQ71),DISP=OLD
//MAKEJ4   EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DATA,DLM='@@'
//RCVQ72   JOB (OFTP),'RCV Q72',CLASS=A,MSGCLASS=H
//S        EXEC PGM=IEFBR14
//D                                 DD  DSN=IBMUSER.RCVTEST.JOBQ72.?ID, Q72BAD10
//             DISP=(NEW,CATLG),UNIT=SYSDA,SPACE=(TRK,1)
@@
//SYSUT2   DD  DSN=IBMUSER.TSTRCVM.JCL(RCVQ72),DISP=OLD
//MAKEJ5   EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DATA,DLM='@@'
//RCVSYM   JOB (OFTP),'RCV SYM',CLASS=A,MSGCLASS=H
//COPY     EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
?IDX ?PFILE1 ?KEYS ?VFILEX ?ID.X ?ID-?KEY
/*
//SYSUT2   DD  DSN=IBMUSER.RCVTEST.JOBSYM,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,1),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//DONE     EXEC PGM=IEFBR14
//D        DD  DSN=IBMUSER.RCVTEST.JOBSYM.DONE,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,1)
@@
//SYSUT2   DD  DSN=IBMUSER.TSTRCVM.JCL(RCVSYM),DISP=OLD
//DELLOAD  EXEC PGM=IEFBR14
//D1       DD  DISP=(MOD,DELETE),DSN=IBMUSER.TSTRCVM.LOAD,
//             UNIT=SYSDA,SPACE=(TRK,1)
//MAKELOAD EXEC PGM=IEBCOPY
//SYSPRINT DD  SYSOUT=*
//IN       DD  DISP=SHR,DSN=SYS1.LINKLIB
//OUT      DD  DSN=IBMUSER.TSTRCVM.LOAD,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1,2)),
//             DCB=(RECFM=U,BLKSIZE=19069,DSORG=PO)
//SYSIN    DD  *
         COPY INDD=IN,OUTDD=OUT
         SELECT MEMBER=IEFBR14
/*
//* the first rule set; TSTRCVM2 and TSTRCVM3 replace it
//RULESET  EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
* rule set 1
RULE=PAT    FROM=TSTA VFN=TSTRCV.PAT.*
            DSN=IBMUSER.RCVTEST.%ID.%Q3 VOLSER=WORK01 SPACE=2
RULE=DAT    FROM=TSTA VFN=TSTRCV.DAT.*  DSN=IBMUSER.RCVTEST.D%MM%DD.%Q3
            REPLACE=Y
RULE=REP    VFN=TSTRCV.REP.*  DSN=IBMUSER.RCVTEST.REP.%Q3  REPLACE=Y
RULE=NOREP  VFN=TSTRCV.NOR.*  DSN=IBMUSER.RCVTEST.NOR.%Q3
RULE=PDS    VFN=TSTRCV.PDS.*  DSN=IBMUSER.RCVTEST.PDS.%Q3  REPLACE=Y
RULE=BAD    VFN=TSTRCV.BAD.*  DSN=IBMUSER.RCVTEST.%Q3
RULE=JOB1   VFN=TSTRCV.JOB.ONE   DSN=IBMUSER.RCVTEST.JOB.%Q3
            JOB=IBMUSER.TSTRCVM.JCL(RCVJOB)
RULE=JOBL   VFN=TSTRCV.JOB.LONG  DSN=IBMUSER.RCVTEST.JOB.%Q3
            JOB=IBMUSER.TSTRCVM.JCL(RCVLONG)
RULE=JOBN   VFN=TSTRCV.JOB.NONE  DSN=IBMUSER.RCVTEST.JOB.%Q3
            JOB=IBMUSER.TSTRCVM.JCL(NOSUCH)
RULE=JOBU   VFN=TSTRCV.JOB.RECU  DSN=IBMUSER.RCVTEST.JOB.%Q3
            JOB=IBMUSER.TSTRCVM.LOAD(IEFBR14)
RULE=JOBQ1  VFN=TSTRCV.JOB.Q71   DSN=IBMUSER.RCVTEST.JOB.%Q3
            JOB=IBMUSER.TSTRCVM.JCL(RCVQ71)
RULE=JOBQ2  VFN=TSTRCV.JOB.Q72   DSN=IBMUSER.RCVTEST.JOB.%Q3
            JOB=IBMUSER.TSTRCVM.JCL(RCVQ72)
RULE=JOBSYM VFN=TSTRCV.JOB.SYM   DSN=IBMUSER.RCVTEST.JOB.%Q3
            JOB=IBMUSER.TSTRCVM.JCL(RCVSYM)
/*
//SYSUT2   DD  DSN=IBMUSER.TSTRCVM.RULES,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,1),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//*
//TSTRCVMA JOB (OFTP),'OFTPD A',CLASS=A,MSGCLASS=H
//* A sends: SVC=, ADMIN= the user who runs TSTRCVM. Stop with
//* P TSTRCVMA. The load library is APF-authorized (change SYS2.LINKLIB).
//OFTPD    EXEC PGM=OFTPD,REGION=4096K
//STEPLIB  DD  DISP=SHR,DSN=SYS2.LINKLIB
//OFTPSPL  DD  DISP=OLD,DSN=IBMUSER.OFTPA.SPOOL
//SYSPRINT DD  SYSOUT=*
//STDOUT   DD  SYSOUT=*
//STDERR   DD  SYSOUT=*
//OFTPPRM  DD  *
ODETTEID=O0000000000TSTA
PORT=3305 SVC=237 ADMIN=IBMUSER
INPREFIX=IBMUSER.OFTPAIN TMPPREFIX=IBMUSER.OFTPATMP
SDEB=4096 CREDIT=99 TIMEOUT=60 RETRY=60
/*
//OFTPPTN  DD  *
PARTNER=TSTB ODETTEID=O0000000000TSTB
  PASSWORD=TSTB OURPASSWORD=TSTA HOST=127.0.0.1 PORT=3315
/*
//*
//TSTRCVMB JOB (OFTP),'OFTPD B',CLASS=A,MSGCLASS=H
//* B receives with the rules of the data set behind OFTPRCV. Stop with
//* P TSTRCVMB, read the rules again with F TSTRCVMB,REFRESH.
//OFTPD    EXEC PGM=OFTPD,REGION=4096K
//STEPLIB  DD  DISP=SHR,DSN=SYS2.LINKLIB
//OFTPSPL  DD  DISP=OLD,DSN=IBMUSER.OFTPB.SPOOL
//SYSPRINT DD  SYSOUT=*
//STDOUT   DD  SYSOUT=*
//STDERR   DD  SYSOUT=*
//OFTPPRM  DD  *
ODETTEID=O0000000000TSTB
PORT=3315
INPREFIX=IBMUSER.OFTPBIN TMPPREFIX=IBMUSER.OFTPBTMP
SDEB=4096 CREDIT=99 TIMEOUT=60 RETRY=60
UNIT=SYSDA VOLSER=WORK00
/*
//OFTPPTN  DD  *
PARTNER=TSTA ODETTEID=O0000000000TSTA
  PASSWORD=TSTA OURPASSWORD=TSTB
/*
//OFTPRCV  DD  DISP=SHR,DSN=IBMUSER.TSTRCVM.RULES
//*
//TSTRCVMC JOB (OFTP),'OFTPD B SVC',CLASS=A,MSGCLASS=H
//* B again, for TSTRCVM 4 (the job after receipt, #45): the same spool
//* and the same rules, but with the SVC, so that the test can read what
//* B recorded of the jobs. A and B must be stopped first (P TSTRCVMA,
//* P TSTRCVMB); the SVC is A's number.
//OFTPD    EXEC PGM=OFTPD,REGION=4096K
//STEPLIB  DD  DISP=SHR,DSN=SYS2.LINKLIB
//OFTPSPL  DD  DISP=OLD,DSN=IBMUSER.OFTPB.SPOOL
//SYSPRINT DD  SYSOUT=*
//STDOUT   DD  SYSOUT=*
//STDERR   DD  SYSOUT=*
//OFTPPRM  DD  *
ODETTEID=O0000000000TSTB
PORT=3315 SVC=237 ADMIN=IBMUSER
INPREFIX=IBMUSER.OFTPBIN TMPPREFIX=IBMUSER.OFTPBTMP
SDEB=4096 CREDIT=99 TIMEOUT=60 RETRY=60
UNIT=SYSDA VOLSER=WORK00
/*
//OFTPPTN  DD  *
PARTNER=TSTA ODETTEID=O0000000000TSTA
  PASSWORD=TSTA OURPASSWORD=TSTB
/*
//OFTPRCV  DD  DISP=SHR,DSN=IBMUSER.TSTRCVM.RULES
