#import "../bookmaster/bookmaster.typ": *
#import "msg-lib.typ": msg

#msg("OFTP100I", "name code ENABLED|DISABLED [n OF n SESSIONS] [TRACE] LEVEL n host:port", [Answer to #cmd("F OFTPD,D P"). OFTPD writes one line for each partner of the partner table. The line gives the partner name, its Odette ID, whether the partner is enabled, and the protocol level of the partner. It ends with the host name and the port, or a hyphen in place of the host if the partner has none. While sessions of the partner run, the line also says #var("n") #cmd("OF") #var("n") #cmd("SESSIONS"), the sessions running and the number allowed. #cmd("TRACE") appears if tracing is on for the partner or for all sessions.], [None. Information only.])

#msg("OFTP101I", "n PARTNERS, n SESSIONS", [Answer to #cmd("F OFTPD,D P"), following the #cmd("OFTP100I") lines. It gives the number of partners in the table and the number of sessions running now. The text #cmd("n SESSIONS") alone is the answer to #cmd("F OFTPD,D S"). It is also the answer to #cmd("F OFTPD,D") with no operand, or with an operand that does not start with P, Q or M. Both forms are followed by #cmd("OFTP127I").], [None. Information only.])

#msg("OFTP102I", "LARGEST FREE BLOCK n KB, n SUBTASK HANDLES, n SESSIONS", [Answer to #cmd("F OFTPD,D M"). It gives the largest block of private-area storage that OFTPD can still get, the number of subtask handles in use, and the number of sessions running. A new session needs a stack of 64 KB.], [None. Information only. A small free block limits the sessions OFTPD can start.])

#msg("OFTP110I", "key dir state partner name", [Answer to #cmd("F OFTPD,D Q"). OFTPD writes one line for each transfer in the spool, in key order. #var("key") is the 8-character transfer key. #var("dir") is #cmd("S") for a send or #cmd("R") for a receive. #var("state") is one letter: #cmd("Q") queued, #cmd("A") in a session, #cmd("W") waiting for a retry, #cmd("H") held, #cmd("S") sent and waiting for the delivery notification, #cmd("D") delivered, #cmd("J") rejected, #cmd("F") failed, #cmd("R") received, #cmd("C") confirmed. #var("name") is the virtual file name of the transfer.], [None. Information only. The #cmd("LIST") and #cmd("SHOW") commands of the OFTP utility give more detail on a transfer.])

#msg("OFTP111I", "n TRANSFERS IN THE SPOOL", [Ends the answer to #cmd("F OFTPD,D Q"). #var("n") is the number of #cmd("OFTP110I") lines written.], [None. Information only. Finished transfers leave the spool after the number of days set by #cmd("KEEPDAYS") in #cmd("OFTPPRM") (0 keeps everything), or when #cmd("F OFTPD,PURGE") is given.])

#msg("OFTP120E", "name IS NOT A PARTNER THAT CAN BE CALLED", [The operator command #cmd("F OFTPD,CALL name") named a partner that cannot be called. The name is not an enabled partner of the table, or the partner has #cmd("CALL=N"), or it has no host to call, or it is reached through another partner. No call is made. The shorter text #cmd("name IS NOT A PARTNER") is written by #cmd("F OFTPD,HOLD"), #cmd("F OFTPD,RELEASE") and #cmd("F OFTPD,TRACE") with a partner operand. For #cmd("HOLD") and #cmd("RELEASE") it means no enabled partner of that name is in the table. For #cmd("TRACE") it means no partner of that name is in the table at all. Nothing is changed.], [Check the name with #cmd("F OFTPD,D P"). If the partner should be callable, correct its entry in #cmd("OFTPPTN") and use #cmd("F OFTPD,REFRESH").])

#msg("OFTP121I", "CALL OF name REQUESTED", [Answer to #cmd("F OFTPD,CALL name"). OFTPD has marked the partner for a call and wakes its scheduler. At its next turn the scheduler opens a session to the partner, unless the partner already runs as many sessions as it is allowed or OFTPD runs as many as #cmd("MAXSESS") allows. The message does not say that the call succeeded.], [None. Look in the log for the messages of the call (#cmd("OFTP206P"), #cmd("OFTP207P")) and of the session.])

#msg("OFTP122E", "PURGE: DAYS MUST BE 0-9999, NOT text", [The operand of #cmd("F OFTPD,PURGE") is not a number from 0 to 9999. #var("text") is the operand as typed. The variant #cmd("PURGE NEEDS DAYS: KEEPDAYS=0 KEEPS EVERYTHING") is written when no operand is given and #cmd("KEEPDAYS") in #cmd("OFTPPRM") is 0, so there is no number to use. Nothing is deleted.], [Enter #cmd("F OFTPD,PURGE days") with a number from 0 to 9999.])

#msg("OFTP123E", "verb NEEDS A PARTNER OR ALL", [The command #cmd("F OFTPD,HOLD") or #cmd("F OFTPD,RELEASE") was given without an operand. #var("verb") is #cmd("HOLD") or #cmd("RELEASE"). Nothing is changed.], [Enter the command again with a partner name, or #cmd("ALL") for every partner.])

#msg("OFTP124I", "TRACE ON|OFF FOR ALL SESSIONS", [Answer to #cmd("F OFTPD,TRACE ON") or #cmd("F OFTPD,TRACE OFF") without a partner. From now on the protocol commands of all sessions, including sessions already running, are written to the log as #cmd("OFTP290P") lines (#cmd("ON")), or the tracing of all partners is ended (#cmd("OFF")). The variant #cmd("TRACE ON|OFF FOR PARTNER name") is the answer when a partner is named. It switches the trace of that partner only.], [None. Information only.])

#msg("OFTP125E", "TRACE IS ON FOR ALL SESSIONS, TRACE OFF WITHOUT A PARTNER ENDS IT", [The command #cmd("F OFTPD,TRACE OFF name") named a partner while the trace is on for all sessions. The trace of a single partner cannot be taken out of a trace for all, so nothing is changed.], [Enter #cmd("F OFTPD,TRACE OFF") without a partner to end all tracing. Then switch it on again for the partners wanted.])

#msg("OFTP126E", "TRACE NEEDS ON OR OFF, THEN A PARTNER OR NOTHING", [The first operand of #cmd("F OFTPD,TRACE") is missing, or is neither #cmd("ON") nor #cmd("OFF"). Nothing is changed.], [Enter #cmd("F OFTPD,TRACE ON") or #cmd("F OFTPD,TRACE OFF"), with a partner name if only one partner is to be traced.])

#msg("OFTP127I", "TRACE ON FOR ALL SESSIONS", [Written by #cmd("F OFTPD,D P") and #cmd("F OFTPD,D S") as the last line of the answer. It tells which tracing is on. Variants: #cmd("TRACE OFF") if no tracing is on, and #cmd("TRACE ON FOR PARTNERS: name ...") with the names of the traced partners. Names that do not fit the line are left out.], [None. Information only. Use #cmd("F OFTPD,TRACE OFF") to end tracing.])

#msg("OFTP199E", "UNKNOWN COMMAND: text", [The text after #cmd("F OFTPD,") is not a command of OFTPD. #var("text") is the whole text as received, in upper case, cut at 79 characters. OFTPD ignores it. The commands are #cmd("D"), #cmd("DISPLAY"), #cmd("CALL"), #cmd("REFRESH"), #cmd("HOLD"), #cmd("RELEASE"), #cmd("TRACE") and #cmd("PURGE"). To stop OFTPD, use #cmd("P OFTPD"), not a modify command.], [Correct the command and enter it again.])
