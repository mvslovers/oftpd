)ATTR
 % TYPE(TEXT)   INTENS(HIGH) SKIP(ON)
 + TYPE(TEXT)   INTENS(LOW)  SKIP(ON)
 _ TYPE(INPUT)  INTENS(HIGH) JUST(LEFT)
 @ TYPE(OUTPUT) INTENS(LOW)  JUST(LEFT)
)BODY
%-------------------------- OFTP370 - Monitor ------------------------------
+
@OFTL1
@OFTL2
@OFTL3
@OFTL4
@OFTL5
+
+  OFTPD control port, kept in your ISPF profile:
+    Host ===>_OFTHOST                                                  +
+    Port ===>_OFTPORT+
+
@OFTMSG
+  Enter to look again, END to return.
)INIT
  .CURSOR = OFTHOST
)PROC
  VER (&OFTHOST,NONBLANK)
  VER (&OFTPORT,NONBLANK)
  VER (&OFTPORT,NUM)
)END
