%------------------------ OFTPD - Configure the Partners -/-/-------------------
+
+
+  Partner member ===>_OFTCDSN                                       +
+
+     the data set and member OFTPD reads as OFTPPTN, without quotes,
+     for example SYS2.PARMLIB(OFTPPTN0); kept in your ISPF profile
+
+
+  Enter edits the member. When the edit ends, OFTPD reads it again:
+
+     changed partners are updated,
+     new ones are added,
+     removed ones are disabled.
+
+
!OFTMSG
+
+  END leaves without editing.
)INIT
  .CURSOR = OFTCDSN
)PROC
  VER (&OFTCDSN,NONBLANK)
)END
