)ATTR
 + TYPE(TEXT)   INTENS(LOW)  SKIP(ON)   COLOR(GREEN)
 % TYPE(TEXT)   INTENS(HIGH) SKIP(ON)   COLOR(WHITE)
 _ TYPE(INPUT)  INTENS(HIGH) JUST(LEFT) COLOR(TURQ)
 ! TYPE(OUTPUT) INTENS(HIGH) JUST(LEFT) CAPS(OFF) COLOR(YELLOW)
)BODY WIDTH(&ZSCREENW) EXPAND(//)
%-------------------------- OFTPD - Send a Data Set -/-/------------------------
+
%  To
+
+    Partner   ===>_OFTPTN  +   ? shows the partners to pick one from
+
%  What
+
+    Data set  ===>_OFTDSN                                       +
+                  fully qualified, without quotes;
+                  a member in parentheses
+
+    Virtual   ===>_OFTVFN                    +
+    file name     the name the partner sees, at most 26 characters;
+                  blank takes the data set or member name
+
%  How
+
+    Text      ===>_Z+   Y: format T, EBCDIC to ASCII, CR-LF after each record
+    Translate ===>_Z+   Y: F, V and U data translated as well
+    Hold      ===>_Z+   Y: queued held, released later from the transfer list
+
+    User data ===>_OFTUSR  +   the SFID user field, at most 8 characters
+
+
!OFTMSG
+
+  Enter queues the file, END leaves.
)INIT
  .ZVARS = '(OFTFMT OFTXLT OFTHLD)'
  .CURSOR = OFTPTN
)PROC
  VER (&OFTPTN,NONBLANK)
  IF (&OFTPTN NE ?)
    VER (&OFTDSN,NONBLANK)
  VER (&OFTFMT,LIST,Y,N)
  VER (&OFTXLT,LIST,Y,N)
  VER (&OFTHLD,LIST,Y,N)
)END
