//OFTPD    PROC M=OFTPPRM0,P=OFTPPTN0,
//            D='SYS2.PARMLIB',
//            S='OFTP.SPOOL'
//*
//* OFTPD - the OFTP monitor, started task
//*
//* Installation:
//*   Copy to SYS2.PROCLIB(OFTPD)
//*   Copy OFTPPRM0 and OFTPPTN0 to SYS2.PARMLIB and edit them
//*   Define the spool once with the job in member OFTPSPL
//*
//* The log:     DD OFTPLOG gets every message with a date and time in
//*              front (the console only the ones an operator must act
//*              on); RECFM=F or FB, LRECL 143 or more keeps a line whole.
//*              Without the DD everything goes to the console.
//* Starting:    /S OFTPD
//*              /S OFTPD,M=OFTPPRM1     (another monitor member)
//*              /S OFTPD,P=OFTPPTN1     (another partner member)
//*              /S OFTPD,S='MY.SPOOL'   (another spool)
//* Commands:    /F OFTPD,D P            (partners)
//*              /F OFTPD,D Q            (the spool)
//*              /F OFTPD,D S            (sessions)
//*              /F OFTPD,CALL partner   (call a partner now)
//*              /F OFTPD,REFRESH        (read the partner member again)
//*              /F OFTPD,HOLD partner   (every send to it; ALL)
//*              /F OFTPD,RELEASE partner
//*              /F OFTPD,PURGE 30       (finished transfers > 30 days)
//*              /F OFTPD,TRACE ON       (every command of every session
//*                                       to the log; TRACE ON partner for
//*                                       one partner; TRACE OFF ends it)
//* Stopping:    /P OFTPD
//*
//OFTPD    EXEC PGM=OFTPD,REGION=8M,TIME=1440
//STEPLIB  DD  DISP=SHR,DSN=@LINKLIB@
//OFTPPRM  DD  DSN=&D(&M),DISP=SHR,FREE=CLOSE
//OFTPPTN  DD  DSN=&D(&P),DISP=SHR
//OFTPSPL  DD  DSN=&S,DISP=OLD
//OFTPLOG  DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=160,BLKSIZE=160)
//SYSPRINT DD  SYSOUT=*
//STDOUT   DD  SYSOUT=*
//STDERR   DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
