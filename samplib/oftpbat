//OFTPBAT  JOB (OFTP),'OFTP UTILITY',CLASS=A,MSGCLASS=H
//* ------------------------------------------------------------------
//* The OFTP utility in batch and under the TSO TMP. Edit the library
//* and the names, then submit.
//* ------------------------------------------------------------------
//BATCH    EXEC PGM=OFTP
//STEPLIB  DD  DISP=SHR,DSN=@LINKLIB@
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
* queue a file, look at the spool, show the new transfer
SEND PARTNER(MAC1) DSN('IBMUSER.OFTPD.SAMPLE') -
     VFN(BATCH.TEST2) FORMAT(T)
LIST MINE
PARTNERS
SHOW T9999999
* the partner table (ADMIN= userids): see docs/partners.md
* PARTNER SHOW MAC1
* PARTNER ADD MAC2 ODETTEID(O0000000000MAC2) PASSWORD(SECRET1)
*   (continue a command with a '-' at the end of a line, not here)
* PARTNER DISABLE MAC2
* PARTNER DELETE MAC2
/*
//TSO      EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD  DISP=SHR,DSN=@LINKLIB@
//SYSTSPRT DD  SYSOUT=*
//SYSTSIN  DD  *
OFTP LIST STATUS(DELIVERED)
OFTP SHOW T0000001
OFTP CALL MAC1
